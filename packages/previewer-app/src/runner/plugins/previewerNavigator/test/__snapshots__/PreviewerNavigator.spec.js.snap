            <path
              d="M7.7-.13l2 2-4.5 4.5h10.5v3H5.2l4.5 4.5-2 2-8-8 8-8z"
              fill-rule="evenodd"
            />
          </svg>
           
           
        </button>
      </div>
       
      <div
        class="progress-container"
      >
        <div
          class="width-tracker"
        >
          <div
            class="more"
          />
           
          <div>
            <ol
              class="space-medium"
            >
              <li>
                <button
                  aria-label="Question 1."
                  class="step completed"
                  tabindex="-1"
                >
                   
                   
                  <span
                    aria-hidden="true"
                    class="step-label"
                  >
                    1
                  </span>
                </button>
                 
              </li>
              <li>
                <button
                  aria-current="location"
                  aria-label="Question 2."
                  class="step completed current"
                  tabindex="0"
                >
                  <span
                    aria-hidden="true"
                    class="indicator"
                  >
                    <svg
                      aria-hidden="false"
                      class="icon small"
                      viewBox="0 0 12 12"
                    >
                      <title>

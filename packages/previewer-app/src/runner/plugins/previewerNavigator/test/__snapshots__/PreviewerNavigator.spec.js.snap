                      <path
                        d="M1 8.75a.48.48 0 00.46.25h9.09a.47.47 0 00.45-.25.4.4 0 00-.07-.45L6.35 3.15a.48.48 0 00-.7 0L1.11 8.3a.4.4 0 00-.11.45"
                        fill-rule="evenodd"
                      />
                    </svg>
                  </span>
                   
                   
                  <span
                    aria-hidden="true"
                    class="step-label"
                  >
                    2
                  </span>
                </button>
                 
              </li>
              <li>
                <button
                  aria-label="Question 3."
                  class="step completed"
                  tabindex="-1"
                >
                   
                   
                  <span
                    aria-hidden="true"
                    class="step-label"
                  >
                    3
                  </span>
                </button>
                 
              </li>
              <li>
                <button

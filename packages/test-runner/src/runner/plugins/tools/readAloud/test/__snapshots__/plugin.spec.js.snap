                          <circle
                            class="radio-border"
                            cx="8"
                            cy="8"
                            fill="none"
                            r="7"
                            stroke-width="2"
                          />
                        </svg>
                         
                        <span
                          class="radio-label-text"
                        >
                          Male
                        </span>
                      </label>
                    </div>
                    <div
                      class="radio"
                    >
                      <input
                        id="tao-option-123"
                        name="voice"
                        type="radio"
                        value="female"
                      />
                       
                      <label
                        class="radio-label"
                        for="tao-option-123"
                      >
                        <svg
                          class="radio-button"
                          viewBox="0 0 16 16"
                        >

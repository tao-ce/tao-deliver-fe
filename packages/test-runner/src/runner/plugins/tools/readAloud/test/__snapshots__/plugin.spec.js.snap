exports[`readAloud plugin > stores changed settings into toolsStore and to client 1`] = `
<div
  class="floating-toolbars-wrapper"
>
  
                    
  <div
    class="floating-toolbars"
  >
    
                        
    <div
      class="toolbar-readAloud"
    >
      
                    
      <div
        class="readAloud-bar has-footer"
      >

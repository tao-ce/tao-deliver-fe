                        />
                        
                      </svg>
                      
                       
                      
                       
                      
                    </button>
                    
                     
                    <button
                      aria-label="decrease reading speed"
                      class="icon-bar-btn actionable base-12 secondary circular"
                      title="decrease reading speed"
                    >
                      <svg
                        aria-hidden="true"
                        class="icon medium"
                        viewBox="0 0 16 16"
                      >
                        <title>
                          Minus icon
                        </title>
                        <path
                          d="M0 7h16v2H0z"
                        />
                        
                      </svg>
                      
                       
                      
                       
                      
                    </button>
                    
                  </span>
                  
                </div>
                
                 
                
              </div>
              
            </div>
            
          </footer>
          
        </div>
        
         
        <div
          class="hidden"
          id="tao-ra-sel-123"
        >
          Press enter or space to activate select and read. To move the next available action, use the arrow keys. To close press escape.
        </div>
         
        <div
          class="hidden"
          id="tao-ra-play-123"
        >
          Press enter or space to activate continuous reading. If activated press enter or space to stop the reading.
        </div>
      </div>
      
      
    </div>
    
                
  </div>
  
            
</div>

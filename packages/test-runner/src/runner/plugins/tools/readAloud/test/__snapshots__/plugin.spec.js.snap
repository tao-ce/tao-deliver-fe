                            cx="8"
                            cy="8"
                            fill="none"
                            r="7"
                            stroke-width="2"
                          />
                        </svg>
                         
                        <span
                          class="radio-label-text"
                        >
                          Female
                        </span>
                      </label>
                    </div>
                    
                  </div>
                  
                </div>
                
                 
                <div
                  class="control-row"
                >
                  <label>
                    Speed
                  </label>
                   
                  <span
                    class="stepper changed-control"
                  >
                    <button
                      aria-label="increase reading speed"
                      class="icon-bar-btn actionable base-12 secondary circular"
                      title="increase reading speed"
                    >
                      <svg
                        aria-hidden="true"
                        class="icon medium"
                        viewBox="0 0 16 16"
                      >
                        <title>

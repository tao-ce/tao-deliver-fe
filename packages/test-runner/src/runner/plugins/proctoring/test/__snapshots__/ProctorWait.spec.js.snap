exports[`TestTitle > renders empty, then paused state, then resumed state and fires \`resume\` on button click 2`] = `
<body>
  <div>
    <div
      class="proctor-wait transition"
    >
      
      <h2
        tabindex="-1"
      >
        Your test is paused
      </h2>
       
      <div
        aria-live="assertive"
        class="loading-wrapper"
        role="status"
      >
        <div
          class="loading"
        />
         
        <div
          class="content"
        >
          <p
            class="text"
          >
            Please wait for the proctor to resume your test.
          </p>
          
        </div>
      </div>
      
      
      
    </div>
    
    
  </div>
</body>
`;


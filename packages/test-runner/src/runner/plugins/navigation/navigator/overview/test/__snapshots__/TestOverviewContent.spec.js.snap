exports[`TestOverviewContent > renders steps with different states, grouped into sections, on 3 tabs, from current test part, and indicates current step 1`] = `
<body>
  <div>
    <div
      class="overview"
    >
      <div
        class="tabs"
      >
        <div
          class="tabgroup"
        >
           
          <div
            class="scrollbox"
          >

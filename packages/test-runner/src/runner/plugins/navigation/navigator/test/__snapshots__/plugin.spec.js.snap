exports[`navigator plugin > renders and destroys without error 1`] = `
<body>
  <div>
    
        
    <nav>
      <div
        class="navigator"
      >
        <button
          aria-disabled="true"
          aria-label="Bookmark this question"
          class="actionable secondary circular medium"
          disabled=""
          name="bookmark"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="icon medium"
            viewBox="0 0 16 16"
          >
            <title>
              Bookmark inactive icon
            </title>
            <path
              d="M12 0H4a2.15 2.15 0 00-2 2v13a1 1 0 00.67.94A1 1 0 003 16a1 1 0 00.78-.38L8 10.6l4.22 5a1 1 0 00.78.4 1 1 0 00.33-.06A1 1 0 0014 15V2a2.15 2.15 0 00-2-2zm0 13L8 8l-4 5V2h8z"
            />
          </svg>
           
           
        </button>
         
        <div
          class="button-container end"
        >
           
          <button
            aria-disabled="true"
            aria-label="Attempt. You have 5 attempts left for this question."
            class="actionable primary pill medium"
            disabled=""
            name="attempt"
            type="button"
          >
             
             
            Attempt (5 left)
          </button>
           
        </div>
         
        <div
          class="button-container start"
        />
         
        <div
          class="button-container center"
        >
          <button
            aria-disabled="true"
            aria-label="Go to previous question"
            class="actionable secondary circular small"
            disabled=""
            name="prev"
            type="button"
          >
            <svg
              aria-hidden="true"
              class="icon medium rtl-flip"
              viewBox="0 0 16 16"
            >
              <title>
                Arrow left icon
              </title>
              <path
                d="M7.7-.13l2 2-4.5 4.5h10.5v3H5.2l4.5 4.5-2 2-8-8 8-8z"
                fill-rule="evenodd"
              />
            </svg>
             
             
          </button>
           
          <button
            aria-disabled="true"
            aria-label="Open overview of all 3 questions"
            class="actionable secondary pill small"
            disabled=""
            name="overview"
            type="button"
          >
            <svg
              aria-hidden="true"
              class="icon medium"
              viewBox="0 0 16 16"
            >
              <title>
                Chevron up icon
              </title>
              <path
                d="M8 3l8 8-2 2-6-6-6 6-2-2 8-8z"
              />
            </svg>
             
             
            Overview (3)
          </button>
           
          <button
            aria-disabled="true"
            aria-label="Skip question"
            class="actionable secondary circular small"
            disabled=""
            name="skip"
            type="button"
          >
            <svg
              aria-hidden="true"
              class="icon medium rtl-flip"
              viewBox="0 0 16 16"
            >
              <title>
                Arrow right icon
              </title>
              <path
                d="M8 16l-2-2 4.5-4.5H0v-3h10.5L6 2l2-2 8 8-8 8z"
                fill-rule="evenodd"
              />
            </svg>
             
             
          </button>
          
          
        </div>
        
      </div>
      
    </nav>
    
        
    <div
      class="overlay"
    >
      
            
      <div
        id="overlay-header"
      />
      
            
      <div
        id="overlay-content"
      />
      
            
      <div
        id="overlay-footer"
      />
      
        
    </div>
  </div>
</body>
`;

            "attributes": {
                "identifier": "graphic_match_vegetarian",
                "title": "Jessica is a vegetarian (Graphic Gap Match Interaction)",
                "label": "Jessica is a vegetarian (Graphic Gap Match Interaction)",
                "xml:lang": "en-US",
                "adaptive": false,
                "timeDependent": false,

exports[`Svg > rendering > renders slot contents 1`] = `
<body>
  <div>
    
    <svg
      aria-labelledby="tao-desc-123"
      height="3000"
      style="--shadow-filter-url: url(#tao-svg-123-filter-shadow);"
      version="1.1"
      viewBox="0 0 5000 3000"
      width="5000"
      xmlns="http://www.w3.org/2000/svg"
      xmlns:svgjs="http://svgjs.com/svgjs"
      xmlns:xlink="http://www.w3.org/1999/xlink"
    >
      <desc
        id="tao-desc-123"
      >
        graphic interaction
      </desc>
      
      <defs>
        <filter
          filterUnits="userSpaceOnUse"
          id="tao-svg-123-filter-shadow"
        >
          <fedropshadow
            dx="0"
            dy="0"
            flood-color="black"
            stdDeviation="1.5"
          />
        </filter>
      </defs>
      <g
        slot="bay"
      >
        <text>
          Test Bay Slot
        </text>
      </g>
      
      <g
        class="image"
        transform="translate(0, 0)"
      >
        <image
          class="svg-image"
          height="300"
          href="file.png"
          preserveAspectRatio="none"
          width="500"
          x="0"
          y="0"
        />
        
        <g
          slot="content"
        >
          <text>
            Test Content Slot
          </text>
        </g>
        
      </g>
    </svg>
    
    
    
  </div>
</body>
`;

      <div
        class="wrap"
      >
        
         
        <div
          class="uploading hidden"
        >
          
        </div>
         
        <div
          class="file-select disabled"
          dir=""
        >
          <input
            accept="image/png"
            aria-hidden="true"
            class="file-select-input"
            disabled=""
            tabindex="-1"
            type="file"
          />
           
          
           
          <span
            class="label"
          >
            Browse your computer
          </span>
           
          <div
            class="browse-container"
          >
            <button
              aria-disabled="true"
              class="actionable primary pill medium"
              disabled=""
              type="button"
            >
              
               
              
               
              Select a file
              
            </button>
            
          </div>
           
          <div
            class="applied-rules"
          >
            <span
              class="applied-rule"
            >
              Accepted: .png.
            </span>
            
             
            <span
              class="applied-rule"
            >
              Maximum file size: 1 MB
            </span>
            
          </div>
           
          <div
            aria-hidden="true"

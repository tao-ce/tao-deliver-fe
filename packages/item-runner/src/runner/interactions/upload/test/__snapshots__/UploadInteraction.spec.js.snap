exports[`UploadInteraction > listens store modifications 1`] = `
<body>
  <div>
    <div
      class="qti-interaction qti-blockInteraction qti-uploadInteraction"
      dir=""
    >
      
       
      <div
        class="wrap"
      >
        
         
        <div
          class="uploading hidden"
        >
          
        </div>
         
        <div
          class="file-select"
          dir=""
        >
          <input
            aria-hidden="true"
            class="file-select-input"
            tabindex="-1"
            type="file"
          />
           
          
           
          <span
            class="label"
          >
            Browse your computer
          </span>
           
          <div
            class="browse-container"
          >
            <button
              class="actionable primary pill medium"
              type="button"
            >
              
               
              
               
              Select a file
              
            </button>
            
          </div>
           
          <div
            class="applied-rules"
          >
            
             
            <span
              class="applied-rule"
            >
              Maximum file size: 1 MB
            </span>
            
          </div>
           
          <div
            aria-hidden="true"
            class="drop-container"
          >
            <div
              class="drop-area"
              role="region"
            >
              <span>
                ... or drop your file here
              </span>
            </div>
          </div>
          
          
        </div>
        
      </div>
       
      <div
        aria-atomic="true"
        aria-live="assertive"
        class="visually-hidden"
        id="tao-live-123"
      >
        
      </div>
      
    </div>
    
    
  </div>
</body>
`;

exports[`UploadInteraction > listens store modifications 2`] = `
<body>
  <div>
    <div
      class="qti-interaction qti-blockInteraction qti-uploadInteraction"
      dir=""
    >
      
       
      <div
        class="wrap"
      >
        
         
        <div
          class="uploading"
        >
          
        </div>
         
        <div
          class="file-select"
          dir=""
        >
          <input
            aria-hidden="true"
            class="file-select-input"
            tabindex="-1"
            type="file"
          />
           
          <div
            class="selected-file-container"
          >
            <p
              tabindex="-1"
            >
              <span
                aria-label="File selected successfully"
              >
                <svg
                  aria-hidden="true"
                  class="icon medium"
                  viewBox="0 0 16 16"
                >
                  <title>
                    Check mark icon
                  </title>
                  <path
                    d="M14.73 1.91L16 3.18 5.09 14.09 0 9l1.27-1.27 3.82 3.82z"
                  />
                  
                </svg>
                
              </span>
               
              <span>
                Answer file selected:
              </span>
               
              <a
                download="test.png"
                href="object-url"
                rel="noreferrer"
                target="_blank"
              >
                test.png
              </a>
              
              
            </p>
             
            <button
              class="actionable secondary pill medium"
              type="button"
            >
              
               
              
               
              Select different file
              
            </button>
            
             
            <button
              class="actionable secondary pill medium"
              type="button"
            >
              
               
              
               
              Clear file
              
            </button>
            
          </div>
          
           
          
        </div>
        
      </div>
       
      <div
        aria-atomic="true"
        aria-live="assertive"
        class="visually-hidden"
        id="tao-live-123"
      >
        
      </div>
      
    </div>
    
    
  </div>
</body>
`;


exports[`ExtendedTextInteraction > renders interaction with props and format xhtml 1`] = `
<body>
  <div>
    <div
      ariabar="baz"
      ariafoo="12"
      class="qti-interaction qti-blockInteraction qti-extendedTextInteraction foo bar baz"
      data-baz="24"
      data-foo="bar"
      data-format="xhtml"
      dir="rtl"
      id="interactionId"
      lang="hu"
      role="someUniqueRole"
    >
       
      <div
        aria-controls="tao-extendedTextInteraction-123"
        class="do-not-read has-feedbacks auto-height"
        style="
            --control-default-height: calc(
                var(--base-control-height) - 0px - 0 - var(--feedbacks-margin-top)
            );
            --rows-count: null
        "
      >
        <div
          class="cke-wrapper resize-vertical disabled required"
          style="--min-height: calc(4rem + 3 * var(--row-height))"
        >
          <textarea
            aria-label="Your answer"
            aria-required="true"
            disabled=""
            id="tao-texteditor-123"
            maxlength="20000"
            name="Text editor"
            placeholder="some placeholder"
            required=""
            spellcheck="true"
          />
        </div>
         
        <label
          for="tao-extendedText-editor-123"
        >
          <ul
            class="feedbacks do-not-read"
            dir="ltr"
            id="tao-extendedTextInteraction-123"
            lang="nb-NO"
          >
            <li
              aria-live="polite"
              class="feedback"
            >
               
              <span>
                Answer required.
              </span>
               
            </li>
          </ul>
        </label>
      </div>
    </div>
    
  </div>
</body>
`;


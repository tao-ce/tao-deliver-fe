exports[`UploadInteraction > shows download link of uploaded file 1`] = `
<body>
  <div>
    <div
      class="qti-interaction qti-reviewInteraction qti-blockInteraction qti-uploadInteraction"
    >
       
       
      <div
        class="selected-file-container"
      >
        <p
          tabindex="-1"
        >
          <svg
            aria-hidden="false"
            class="icon medium"
            viewBox="0 0 16 16"
          >
            <title>
              Check mark icon
            </title>
            <path
              d="M14.73 1.91L16 3.18 5.09 14.09 0 9l1.27-1.27 3.82 3.82z"
            />
          </svg>
           
          <span>
            Answer file selected:
          </span>
           
          <a
            download="foo.png"
            href="http://example.com/download-asset?id=oaeuaoeu"
            rel="noreferrer"
            target="_blank"
          >
            foo.png
          </a>
        </p>
      </div>
    </div>
  </div>
</body>
`;


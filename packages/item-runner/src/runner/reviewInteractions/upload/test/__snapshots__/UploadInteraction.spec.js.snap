// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`UploadInteraction > renders a plagiarism report 1`] = `
<body>
  <div>
    <div
      class="qti-interaction qti-reviewInteraction qti-blockInteraction qti-uploadInteraction"
    >
       
      <p
        class="plagiarism-message suspicious"
      >
        <svg
          aria-hidden="false"
          class="icon medium"
          viewBox="0 0 16 16"
        >
          <title>
            Warning icon
          </title>
          <path
            d="M8 1a7 7 0 11-7 7 7 7 0 017-7m0-1a8 8 0 108 8 8 8 0 00-8-8z"
          />
          <path
            d="M7 3h2v6H7zm0 8h2v2H7z"
          />
        </svg>
         
        Suspicion of plagiarism:
         
        <a
          href="http://example.com"
          target="_blank"
        >
          view report
        </a>
      </p>
      
      
      
       
      <div
        class="selected-file-container empty"
      >
        <p
          tabindex="-1"
        >
          <svg
            aria-hidden="false"
            class="icon medium"
            viewBox="0 0 16 16"
          >
            <title>
              Remove icon
            </title>
            <path
              d="M1 0l7 7 7-7 1 1-7 7 7 7-1 1-7-7-7 7-1-1 7-7-7-7 1-1z"
            />
          </svg>
           
          <span>
            No answer file selected
          </span>
        </p>
      </div>
    </div>
    
  </div>
</body>
`;


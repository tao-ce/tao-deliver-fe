                        "prompt": {
                            "serial": "container_containerstatic_5ebeb83c74cbf894143094",
                            "body": "<div><div class=\"qti-include\" data-serial=\"include_fkp1ghqu4ljn4h2wpyortc\">\u0627\u0644\u064a\u0627\u0628\u0627\u0646 (/ d\u0292\u0259\u02c8p\u00e6n / \u061b \u0627\u0644\u064a\u0627\u0628\u0627\u0646\u064a\u0629: \u65e5\u672c \u060c \u0646\u064a\u0628\u0648\u0646 [\u0272ippo\ua71c\u0274] (\u062d\u0648\u0644 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0635\u0648\u062a \u0647\u0630\u0647) \u0623\u0648 Nihon [\ua71c\u0274iho\ua71c\u0274] (\u062d\u0648\u0644 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0635\u0648\u062a \u0647\u0630\u0647)) [a] \u0628\u0644\u062f \u062c\u0632\u064a\u0631\u0629 \u0641\u064a \u0634\u0631\u0642 \u0622\u0633\u064a\u0627. \u064a\u062d\u062f\u0647\u0627 \u0628\u062d\u0631 \u0627\u0644\u064a\u0627\u0628\u0627\u0646 \u0645\u0646 \u0627\u0644\u063a\u0631\u0628 \u0648\u0627\u0644\u0645\u062d\u064a\u0637 \u0627\u0644\u0647\u0627\u062f\u0626 \u0645\u0646 \u0627\u0644\u0634\u0631\u0642 \u060c \u0648\u062a\u0645\u062a\u062f \u0645\u0646 \u0628\u062d\u0631 \u0623\u0648\u062e\u0648\u062a\u0633\u0643 \u0641\u064a \u0627\u0644\u0634\u0645\u0627\u0644 \u0627\u0644\u0634\u0631\u0642\u064a \u0625\u0644\u0649 \u0628\u062d\u0631 \u0627\u0644\u0635\u064a\u0646 \u0627\u0644\u0634\u0631\u0642\u064a \u0641\u064a \u0627\u0644\u062c\u0646\u0648\u0628 \u0627\u0644\u063a\u0631\u0628\u064a. \u062c\u0632\u0621 \u0645\u0646 \u062d\u0644\u0642\u0629 \u0627\u0644\u0646\u0627\u0631 \u060c \u062a\u0636\u0645 \u0627\u0644\u064a\u0627\u0628\u0627\u0646 \u0623\u0631\u062e\u0628\u064a\u0644 \u0633\u062a\u0631\u0627\u062a\u0648\u0641\u0648\u0644\u0643\u0627\u0646 \u0645\u0646 6\u060c852 \u062c\u0632\u064a\u0631\u0629 \u0648\u062a\u063a\u0637\u064a 380\u060c000 \u0643\u064a\u0644\u0648\u0645\u062a\u0631 \u0645\u0631\u0628\u0639 (150\u060c000 \u0645\u064a\u0644 \u0645\u0631\u0628\u0639) \u061b \u0623\u0643\u0628\u0631 \u062e\u0645\u0633 \u062c\u0632\u0631 \u060c \u0645\u0646 \u0627\u0644\u0634\u0645\u0627\u0644 \u0625\u0644\u0649 \u0627\u0644\u062c\u0646\u0648\u0628 \u060c \u0647\u064a \u0647\u0648\u0643\u0627\u064a\u062f\u0648 \u060c \u0647\u0648\u0646\u0634\u0648 \u060c \u0634\u064a\u0643\u0648\u0643\u0648 \u060c \u0643\u064a\u0648\u0634\u0648 \u060c \u0648\u0623\u0648\u0643\u064a\u0646\u0627\u0648\u0627. \u0637\u0648\u0643\u064a\u0648 \u0647\u064a \u0639\u0627\u0635\u0645\u0629 \u0627\u0644\u0628\u0644\u0627\u062f \u0648\u0627\u0644\u0645\u062f\u064a\u0646\u0629 \u0627\u0644\u0623\u0643\u062b\u0631 \u0627\u0643\u062a\u0638\u0627\u0638\u064b\u0627 \u0628\u0627\u0644\u0633\u0643\u0627\u0646 \u060c \u0628\u064a\u0646\u0645\u0627 \u062a\u0634\u0645\u0644 \u0627\u0644\u0645\u0631\u0627\u0643\u0632 \u0627\u0644\u0625\u0642\u0644\u064a\u0645\u064a\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0623\u0648\u0633\u0627\u0643\u0627 \u0648\u0646\u0627\u063a\u0648\u064a\u0627 \u0648\u0641\u0648\u0643\u0648\u0648\u0643\u0627.</div></div>\n\u0645\u0627 \u0647\u064a \u0639\u0627\u0635\u0645\u0629 \u0627\u0644\u064a\u0627\u0628\u0627\u0646\u061f",

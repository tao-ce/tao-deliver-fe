            "body": {
                "serial": "container_containeritembody_6008579e2c7ec222401907",
                "body": "\n    <div class=\"grid-row\">\n      <div class=\"col-12\">\n        <h1>Slider Interaction</h1>\n        <h2>Calculate a percentage</h2>\n      </div>\n    </div>\n    <div class=\"grid-row\">\n      <div class=\"col-6\">\n        {{interaction_sliderinteraction_6008579e2ca1c954252809}}\n      </div>\n      <div class=\"col-1\"></div>\n      <div class=\"col-5\">{{img_6008579e2cba9030290348}}\n        Boston Skyline, photo by <a href=\"https://www.flickr.com/photos/64655144@N08/19062934099/\" target=\"_blank\">Stephan Zech</a>\n      </div>\n    </div>\n  <div class=\"grid-row\"><div class=\"col-12\">{{interaction_sliderinteraction_6008579e2ca1c9542528092}}</div></div> <div class=\"grid-row\"><div class=\"col-12\">{{interaction_sliderinteraction_6008579e2ca1c9542528093}}</div></div> <div class=\"grid-row\"><div class=\"col-12\">{{interaction_sliderinteraction_6008579e2ca1c9542528094}}</div></div> <div class=\"grid-row\"><div class=\"col-12\">{{interaction_sliderinteraction_6008579e2ca1c9542528095}}</div></div>",
                "elements": {
                    "interaction_sliderinteraction_6008579e2ca1c954252809": {
                        "serial": "interaction_sliderinteraction_6008579e2ca1c954252809",
